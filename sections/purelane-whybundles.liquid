{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'section-purelane-whybundles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign reason_blocks = section.blocks | where: 'type', 'reason'
-%}

<section class="purelane pl-sec pl-whybundles" id="Whybundles-{{ section.id }}" data-scene-zone data-scene-label="Why bundles">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv">
      <div class="pl-panel-head">
        {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      </div>
      {%- if reason_blocks.size > 0 -%}
        <div class="pl-wb">
          {%- for block in reason_blocks -%}
            <div class="pl-wb__i" {{ block.shopify_attributes }}>
              <span class="pl-wb__ci">
                {%- case block.settings.icon -%}
                  {%- when 'price' -%}{{ 'icon-flat-price.svg' | inline_asset_content }}
                  {%- when 'star' -%}{{ 'icon-star-outline.svg' | inline_asset_content }}
                  {%- when 'truck' -%}{{ 'icon-shipping.svg' | inline_asset_content }}
                  {%- else -%}{{ 'icon-savings.svg' | inline_asset_content }}
                {%- endcase -%}
              </span>
              <h4>{{ block.settings.title | escape }}</h4>
              <p>{{ block.settings.description | escape }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why bundles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The smarter way to shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why bundles beat buying single" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "discount", "label": "Discount" },
            { "value": "price", "label": "Checkmark" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Shipping" }
          ],
          "default": "discount"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Save up to 45%" },
        { "type": "text", "id": "description", "label": "Description", "default": "Versus buying the same products separately" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why bundles",
      "blocks": [
        { "type": "reason", "settings": { "icon": "discount", "title": "Save up to 45%", "description": "Versus buying the same products separately" } },
        { "type": "reason", "settings": { "icon": "price", "title": "One flat price", "description": "No calculators, no comparing carts" } },
        { "type": "reason", "settings": { "icon": "star", "title": "Curated by experts", "description": "Products picked to work well together" } },
        { "type": "reason", "settings": { "icon": "truck", "title": "Free shipping always", "description": "Included on every bundle, all India" } }
      ]
    }
  ]
}
{% endschema %}
