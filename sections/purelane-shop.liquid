{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'component-purelane-card.css' | asset_url | stylesheet_tag }}
{{ 'section-purelane-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign products = section.settings.collection.products | default: collections.all.products
  assign limit = section.settings.products_to_show
-%}

<section class="purelane pl-sec pl-shop" id="Shop-{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule">
        <i></i>{{ 'icon-leaf.svg' | inline_asset_content }}<i></i>
      </div>
    </div>

    {%- if products.size > 0 -%}
      <div class="pl-shelf">
        {%- for product in products limit: limit -%}
          <div class="pl-rv{% cycle '', ' pl-rv-d1', ' pl-rv-d2', ' pl-rv-d3' %}">
            {%- render 'card-purelane-product', card_product: product, lazy_load: forloop.index0 > 3 -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="pl-body-s" style="text-align:center">
        {{ 'sections.collection_template.empty' | t | default: 'Select a collection to display products here.' }}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Shop grid"
    }
  ]
}
{% endschema %}
