{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'section-purelane-categories.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign category_blocks = section.blocks | where: 'type', 'category'
-%}

<section class="purelane pl-sec pl-categories-sec" id="Categories-{{ section.id }}" data-scene-zone data-scene-label="Bundle categories">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
    </div>

    {%- if category_blocks.size > 0 -%}
      <div class="pl-cats">
        {%- for block in category_blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign title = block.settings.title | default: collection.title
            assign subtitle = block.settings.subtitle
            assign link = block.settings.link | default: collection.url | default: '#combos'
            assign img = block.settings.image | default: collection.featured_image | default: collection.image
          -%}
          <a
            class="pl-glass pl-cat pl-rv{% cycle '', ' pl-rv-d1', ' pl-rv-d2', ' pl-rv-d3' %}"
            href="{{ link }}"
            {{ block.shopify_attributes }}
          >
            <span class="pl-cat__ph">
              {%- if img != blank -%}
                <img
                  class="pl-cat__img"
                  src="{{ img | image_url: width: 400 }}"
                  alt="{{ img.alt | default: title | escape }}"
                  width="{{ img.width }}"
                  height="{{ img.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {%- comment -%} No collection/custom image set yet -- use the matching item from
                  the prototype's own product-shape lineup instead of a generic bottle. {%- endcomment -%}
                <img class="pl-cat__img pl-hp--placeholder" src="{{ 'product-art-' | append: block.settings.placeholder_art | append: '.svg' | asset_url }}" alt="" width="130" height="360" loading="lazy">
              {%- endif -%}
            </span>
            <span class="pl-cat__txt">
              <h3>{{ title | escape }}</h3>
              {%- if subtitle != blank -%}<p>{{ subtitle | escape }}</p>{%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="pl-cats__empty">
        Add category blocks in theme editor to display bundle categories.
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bundle categories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Grease, dishes & more"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        },
        {
          "type": "select",
          "id": "placeholder_art",
          "label": "Preview art (until a collection/image is set)",
          "options": [
            { "value": "kitchen", "label": "Kitchen" },
            { "value": "toilet", "label": "Bathroom" },
            { "value": "laundry", "label": "Laundry" },
            { "value": "tap", "label": "Hard water / tap" },
            { "value": "dish", "label": "Dishwash" },
            { "value": "handwash", "label": "Handwash" },
            { "value": "metal", "label": "Metal cleaner" },
            { "value": "wm", "label": "Washing machine" },
            { "value": "floor", "label": "Floor" },
            { "value": "eraser", "label": "Eraser" }
          ],
          "default": "kitchen"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Kitchen bundle", "subtitle": "Grease, dishes & more", "placeholder_art": "kitchen" } },
        { "type": "category", "settings": { "title": "Bathroom bundle", "subtitle": "Deep clean & disinfect", "placeholder_art": "toilet" } },
        { "type": "category", "settings": { "title": "Laundry bundle", "subtitle": "Softer, fresher wash", "placeholder_art": "laundry" } },
        { "type": "category", "settings": { "title": "Hard water bundle", "subtitle": "Melt away limescale", "placeholder_art": "tap" } }
      ]
    }
  ]
}
{% endschema %}
