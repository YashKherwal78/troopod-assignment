{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'section-purelane-categories.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign category_blocks = section.blocks | where: 'type', 'category'
-%}

<section class="purelane pl-sec pl-categories-sec" id="Categories-{{ section.id }}" data-scene-zone data-scene-label="Bundle categories">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
    </div>

    {%- if category_blocks.size > 0 -%}
      <div class="pl-cats">
        {%- for block in category_blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign title = block.settings.title | default: collection.title
            assign subtitle = block.settings.subtitle
            assign link = block.settings.link | default: collection.url | default: '#combos'
            assign img = block.settings.image | default: collection.featured_image | default: collection.image
          -%}
          <a
            class="pl-glass pl-cat pl-rv{% cycle '', ' pl-rv-d1', ' pl-rv-d2', ' pl-rv-d3' %}"
            href="{{ link }}"
            {{ block.shopify_attributes }}
          >
            <span class="pl-cat__ph">
              {%- if img != blank -%}
                <img
                  class="pl-cat__img"
                  src="{{ img | image_url: width: 400 }}"
                  alt="{{ img.alt | default: title | escape }}"
                  width="{{ img.width }}"
                  height="{{ img.height }}"
                  loading="lazy"
                >
              {%- endif -%}
            </span>
            <span class="pl-cat__txt">
              <h3>{{ title | escape }}</h3>
              {%- if subtitle != blank -%}<p>{{ subtitle | escape }}</p>{%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="pl-cats__empty">
        Add category blocks in theme editor to display bundle categories.
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bundle categories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Grease, dishes & more"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Kitchen bundle", "subtitle": "Grease, dishes & more" } },
        { "type": "category", "settings": { "title": "Bathroom bundle", "subtitle": "Deep clean & disinfect" } },
        { "type": "category", "settings": { "title": "Laundry bundle", "subtitle": "Softer, fresher wash" } },
        { "type": "category", "settings": { "title": "Hard water bundle", "subtitle": "Melt away limescale" } }
      ]
    }
  ]
}
{% endschema %}
