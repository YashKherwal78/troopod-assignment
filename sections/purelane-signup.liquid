{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'section-purelane-signup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

<section class="purelane pl-sec pl-signup-sec" id="Signup-{{ section.id }}" data-scene-zone data-scene-label="Newsletter">
  <div class="pl-wrap">
    <div class="pl-glass pl-signup pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="pl-d2">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}
        <p class="pl-lede">{{ section.settings.lede }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'pl-signup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="pl-signup__success" tabindex="-1" autofocus>
            {{ 'newsletter.success' | t | default: 'Thanks for subscribing! Check your inbox for your ₹100 discount code.' }}
          </p>
        {%- else -%}
          <input
            type="email"
            id="NewsletterForm-{{ section.id }}"
            name="contact[email]"
            class="pl-signup__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="{{ section.settings.placeholder | default: 'your@email.com' }}"
            aria-label="{{ section.settings.placeholder | default: 'Email address' }}"
            required
          >
          <button class="pl-btn pl-btn-primary" type="submit" name="commit">
            {{ section.settings.button_label | default: 'Get my ₹100 off' }}
          </button>
          {%- if form.errors -%}
            <small class="pl-signup__error">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </small>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter signup",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "text",
      "id": "lede",
      "label": "Supporting text",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my ₹100 off"
    }
  ],
  "presets": [
    {
      "name": "Newsletter signup"
    }
  ]
}
{% endschema %}
