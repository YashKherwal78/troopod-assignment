{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'section-purelane-range.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign collection = section.settings.collection
  assign products = collection.products
  if products == blank and section.settings.product_list != blank
    assign products = section.settings.product_list
  endif
-%}

<section class="purelane pl-sec pl-range-sec" id="Range-{{ section.id }}" data-scene-zone data-scene-label="The full range">
  <div class="pl-wrap">
    <div class="pl-glass pl-range pl-rv">
      <div class="pl-range__head">
        <div>
          {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
          <h2 class="pl-d2">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.body != blank -%}
          <p class="pl-body-s">{{ section.settings.body }}</p>
        {%- endif -%}
      </div>

      <div class="pl-range__stripwrap">
        <div class="pl-range__row">
          {%- if products.size > 0 -%}
            {%- for product in products limit: 14 -%}
              {%- if product.featured_image != blank -%}
                <img
                  class="pl-range__item"
                  src="{{ product.featured_image | image_url: width: 300 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} No collection/products picked yet -- show the prototype's own varied
              product-shape lineup (extracted from reference/purelane-homepage.html as real SVG
              assets) instead of one repeated generic bottle, matching the reference shelf's actual
              mix of shapes exactly (including the eraser's distinct block silhouette). {%- endcomment -%}
            {%- assign range_preview = 'floor,tap,kitchen,toilet,laundry,dish,metal,wm,handwash,eraser' | split: ',' -%}
            {%- for item in range_preview -%}
              <img class="pl-range__item pl-hp--placeholder" src="{{ 'product-art-' | append: item | append: '.svg' | asset_url }}" alt="" width="120" height="332" loading="lazy">
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      {%- if products.size > 0 -%}
        <p class="pl-range__hint">{{ section.settings.hint_text | default: 'Swipe to see the full shelf' }}</p>
      {%- else -%}
        <p class="pl-range__hint">Add products or select a collection above to replace this preview.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Full range shelf",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products override",
      "info": "Optional manual list of products to display on the shelf.",
      "limit": 14
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Mobile hint text",
      "default": "Swipe to see the full shelf"
    }
  ],
  "presets": [
    {
      "name": "Full range shelf"
    }
  ]
}
{% endschema %}
