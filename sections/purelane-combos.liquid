{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'section-purelane-combos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

<section class="purelane pl-sec pl-combos" id="Combos-{{ section.id }}" data-scene-zone data-scene-label="Combos">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule"><i></i>{{ 'icon-leaf-outline.svg' | inline_asset_content }}<i></i></div>
      {%- if section.settings.lede != blank -%}
        <p class="pl-lede" style="margin:14px auto 0">{{ section.settings.lede }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.combos.size > 0 -%}
      <div class="pl-comborail pl-rv">
        {%- for combo in section.settings.combos -%}
          {%- liquid
            assign products = combo.products.value
            assign benefit_lines = combo.benefit_lines.value
            assign compare_total = 0
            for p in products
              assign compare_total = compare_total | plus: p.price
            endfor
            assign bundle_price = combo.price.value | default: 0 | times: 100
            assign savings = compare_total | minus: bundle_price
          -%}
          <article class="pl-glass pl-combo{% if combo.tag.value == 'Most popular' or combo.tag.value == 'Best value' %} pl-combo--hero{% endif %}">
            <div class="pl-combo__tray">
              <span class="pl-combo__save">
                {%- if combo.save_label_override.value != blank -%}
                  {{ combo.save_label_override.value }}
                {%- elsif savings > 0 -%}
                  You save {{ savings | money }}
                {%- endif -%}
              </span>
              {%- if combo.tag.value != blank -%}<span class="pl-combo__flag">{{ combo.tag.value }}</span>{%- endif -%}
              <div class="pl-combo__stack">
                {%- for product in products -%}
                  <span class="pl-combo__it">
                    {%- if product.featured_image != blank -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 160 }}"
                        alt="{{ product.featured_image.alt | default: product.title | escape }}"
                        width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
                        loading="lazy"
                      >
                    {%- else -%}
                      <span class="pl-combo__tile" aria-hidden="true">{{ 'icon-image.svg' | inline_asset_content }}</span>
                    {%- endif -%}
                    {%- assign benefit = benefit_lines[forloop.index0] -%}
                    {%- if benefit != blank -%}<span>{{ benefit }}</span>{%- endif -%}
                  </span>
                  {%- unless forloop.last -%}<span class="pl-combo__plus" aria-hidden="true">+</span>{%- endunless -%}
                {%- endfor -%}
              </div>
            </div>
            <div class="pl-combo__body">
              <h3>{{ combo.title.value | escape }}</h3>
              <div class="pl-combo__cnt">{{ products.size }} products</div>
              {%- if combo.description.value != blank -%}
                <p class="pl-combo__inc">{{ combo.description.value }}</p>
              {%- endif -%}
              <div class="pl-combo__prow">
                <strong>{{ bundle_price | money }}</strong>
                {%- if compare_total > bundle_price -%}<s>{{ compare_total | money }}</s>{%- endif -%}
                {%- if savings > 0 -%}<em>Save {{ savings | money }}</em>{%- endif -%}
              </div>
              <div class="pl-combo__fine">Inclusive of all taxes</div>
              <a class="pl-btn {% if combo.tag.value == 'Best value' %}pl-btn-primary{% else %}pl-btn-ghost{% endif %} pl-btn-full" href="{{ combo.cta_link.value | default: '#bundles' }}" aria-label="{{ combo.cta_label.value | default: 'Shop bundle' }} — {{ combo.title.value | escape }}">
                {{ combo.cta_label.value | default: 'Shop bundle' }}
                {{ 'icon-arrow-right.svg' | inline_asset_content }}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="pl-combos__swipecue" aria-hidden="true">
        {{ 'icon-arrow-right.svg' | inline_asset_content }}Swipe for more combos
      </div>
    {%- else -%}
      {%- comment -%} No combo metaobject entries created yet -- show 5 sample preview cards
        (Dawn's own onboarding pattern for empty collections/products) instead of just a text
        instruction, so the section isn't blank before a merchant adds real combos, and the
        horizontally-scrollable rail is demonstrable with a realistic number of cards. Sample
        copy/pricing mirrors the reference file's own 5 combos exactly. {%- endcomment -%}
      {%- liquid
        assign sample_titles = 'Kitchen essentials|Laundry care bundle|Complete home bundle|Bathroom deep clean|Hard water solution kit' | split: '|'
        assign sample_tags = 'Most popular||Best value||' | split: '|'
        assign sample_counts = '3|3|5|3|2' | split: '|'
        assign sample_prices = '499|499|799|499|349' | split: '|'
        assign sample_compares = '897|947|1495|897|598' | split: '|'
        assign sample_saves = '398|448|696|398|249' | split: '|'
        assign sample_arts = 'kitchen,dish,tap|laundry,handwash,wm|kitchen,floor,handwash|toilet,tap,eraser|tap,toilet' | split: '|'
      -%}
      <div class="pl-comborail pl-rv" aria-hidden="true">
        {%- for title in sample_titles -%}
          {%- assign i = forloop.index0 -%}
          {%- assign tag = sample_tags[i] -%}
          {%- assign arts = sample_arts[i] | split: ',' -%}
          <article class="pl-glass pl-combo{% if tag != blank %} pl-combo--hero{% endif %}">
            <div class="pl-combo__tray">
              <span class="pl-combo__save">Preview &middot; save &#8377;{{ sample_saves[i] }}</span>
              {%- if tag != blank -%}<span class="pl-combo__flag">{{ tag }}</span>{%- endif -%}
              <div class="pl-combo__stack">
                {%- for art in arts -%}
                  <span class="pl-combo__it">
                    <img class="pl-hp--placeholder" src="{{ 'product-art-' | append: art | append: '.svg' | asset_url }}" alt="" width="160" height="443" loading="lazy">
                  </span>
                  {%- unless forloop.last -%}<span class="pl-combo__plus" aria-hidden="true">+</span>{%- endunless -%}
                {%- endfor -%}
              </div>
            </div>
            <div class="pl-combo__body">
              <h3>{{ title }}</h3>
              <div class="pl-combo__cnt">{{ sample_counts[i] }} products</div>
              <p class="pl-combo__inc">Add a real combo in Content &rsaquo; Metaobjects to replace this preview.</p>
              <div class="pl-combo__prow">
                <strong>&#8377;{{ sample_prices[i] }}</strong>
                <s>&#8377;{{ sample_compares[i] }}</s>
                <em>Save &#8377;{{ sample_saves[i] }}</em>
              </div>
              <a class="pl-btn {% if tag == 'Best value' %}pl-btn-primary{% else %}pl-btn-ghost{% endif %} pl-btn-full" href="#" tabindex="-1">Shop bundle</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="pl-combos__swipecue" aria-hidden="true">
        {{ 'icon-arrow-right.svg' | inline_asset_content }}Swipe for more combos
      </div>
      <p class="pl-body-s" style="text-align:center;margin-top:10px">Add combo entries in Content &rsaquo; Metaobjects to replace this preview.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Best-selling combos",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "text", "id": "lede", "label": "Supporting text", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    {
      "type": "metaobject_list",
      "id": "combos",
      "label": "Combos",
      "metaobject_type": "combo"
    }
  ],
  "presets": [
    { "name": "Best-selling combos" }
  ]
}
{% endschema %}
